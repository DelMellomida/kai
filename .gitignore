# ── Model weights and vendored binaries ──────────────────────────────────────────
# ~3 GB between them, and every file is re-downloadable by a setup script. GitHub rejects
# individual files over 100 MB, and several of these are 60-350 MB.
#   voices/       scripts/tts_setup_kokoro.sh, scripts/tts_setup_models.sh, piper.download_voices
#   vendor/       scripts/tts_setup_kokoro.sh
voices/
vendor/

# Rendered voice comparisons — disposable, tens of MB, regenerated by scripts/tts_bench.py
voice-audition/

# ── Generated / machine-local state ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/

# RAG embeddings: ~430 KB of floats regenerated from documents/ by ai/index_documents.py.
# Checking it in means every corpus edit lands as an unreadable diff.
documents/.rag_index.json
documents/.rag_index.json.bak-*

# Dashboard-settable overrides live in ~/.config/kai/settings.json, but ignore a stray local copy.
settings.json

# ── Secrets — belt and braces ────────────────────────────────────────────────────
# The Picovoice key is read from $PICOVOICE_ACCESS_KEY or ~/.config/kai/porcupine.key
# (config/wake.py:20-21), i.e. never in-tree. These patterns exist so it stays that way.
*.key
*.pem
.env
.env.*
porcupine.key

# ── Local tooling ────────────────────────────────────────────────────────────────
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ── OS noise ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
